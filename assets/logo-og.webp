<script type="application/ld+json">{"@context":"https://schema.org","@type":["Organization","LocalBusiness"],"@id":"https://elancier.com#organization","name":"Elancier Solutions","url":"https://elancier.com","logo":"https://elancier.com/storage/branding/IVj5EXJbBXXIcOiyHlr1Am3g.webp","email":"admin@elancier.com","telephone":"+91 81446 88721","address":{"@type":"PostalAddress","streetAddress":"94-19, 2nd floor, Mani Kothanar street, Bypass Rd, Sathyamoorthy Nagar, Madurai, Tamil Nadu 625016","addressCountry":"IN"}}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"WebSite","name":"Elancier Solutions","url":"https://elancier.com"}</script>
