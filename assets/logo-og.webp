<div class="assistant-widget assistant-widget--frontend" id="assistantWidget" data-context="frontend">
  <button type="button" class="assistant-toggle" id="assistantToggle" aria-haspopup="dialog" aria-expanded="false" aria-controls="assistantPanel" aria-label="Open website assistant">
    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <line x1="24" y1="4" x2="24" y2="10" stroke="#fff" stroke-width="2.5" stroke-linecap="round"/>
      <circle cx="24" cy="3.5" r="2.6" fill="#2DD4BF"/>
      <rect x="5" y="18" width="5" height="10" rx="2.5" fill="#fff"/>
      <rect x="38" y="18" width="5" height="10" rx="2.5" fill="#fff"/>
      <rect x="9" y="10" width="30" height="25" rx="11" fill="#fff"/>
      <circle cx="18.5" cy="22" r="3.1" fill="#4338CA"/>
      <circle cx="29.5" cy="22" r="3.1" fill="#4338CA"/>
      <path d="M18 27.5c1.6 1.7 4.1 2.6 6 2.6s4.4-.9 6-2.6" stroke="#4338CA" stroke-width="2.3" stroke-linecap="round" fill="none"/>
    </svg>
    <span class="assistant-toggle-badge" aria-hidden="true"></span>
  </button>

  <div class="assistant-panel" id="assistantPanel" role="dialog" aria-modal="false" aria-labelledby="assistantTitle" hidden>
    <div class="assistant-header">
      <div class="assistant-header-info">
        <span class="assistant-avatar" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <line x1="24" y1="4" x2="24" y2="10" stroke="#fff" stroke-width="2.5" stroke-linecap="round"/>
            <circle cx="24" cy="3.5" r="2.6" fill="#2DD4BF"/>
            <rect x="5" y="18" width="5" height="10" rx="2.5" fill="#fff"/>
            <rect x="38" y="18" width="5" height="10" rx="2.5" fill="#fff"/>
            <rect x="9" y="10" width="30" height="25" rx="11" fill="#fff"/>
            <circle cx="18.5" cy="22" r="3.1" fill="#4338CA"/>
            <circle cx="29.5" cy="22" r="3.1" fill="#4338CA"/>
            <path d="M18 27.5c1.6 1.7 4.1 2.6 6 2.6s4.4-.9 6-2.6" stroke="#4338CA" stroke-width="2.3" stroke-linecap="round" fill="none"/>
          </svg>
        </span>
        <div>
          <div class="assistant-title" id="assistantTitle">Elancier Assistant</div>
          <div class="assistant-subtitle">FAQ-style assistant — not a live chat</div>
        </div>
      </div>
      <div class="assistant-header-actions">
        <button type="button" class="assistant-minimize" id="assistantMinimize" aria-label="Minimize assistant">&#8211;</button>
        <button type="button" class="assistant-close" id="assistantClose" aria-label="Close assistant">&times;</button>
      </div>
    </div>

    <div class="assistant-body" id="assistantBody">
      <div class="assistant-message assistant-message--bot">
        <p>Hi! I&#039;m a quick FAQ assistant for Elancier Solutions. Pick a question below, or type your own.</p>
      </div>
              <div class="assistant-suggestions" id="assistantSuggestions">
                      <button type="button" class="assistant-suggestion" data-question="What services do you provide?">What services do you provide?</button>
                      <button type="button" class="assistant-suggestion" data-question="Do you develop websites?">Do you develop websites?</button>
                      <button type="button" class="assistant-suggestion" data-question="Do you develop Android and iOS applications?">Do you develop Android and iOS applications?</button>
                      <button type="button" class="assistant-suggestion" data-question="Do you provide ecommerce development?">Do you provide ecommerce development?</button>
                      <button type="button" class="assistant-suggestion" data-question="Can I view your portfolio?">Can I view your portfolio?</button>
                      <button type="button" class="assistant-suggestion" data-question="How can I request a quotation?">How can I request a quotation?</button>
                      <button type="button" class="assistant-suggestion" data-question="How can I contact Elancier Solutions?">How can I contact Elancier Solutions?</button>
                      <button type="button" class="assistant-suggestion" data-question="Where is your office located?">Where is your office located?</button>
                      <button type="button" class="assistant-suggestion" data-question="What are your working hours?">What are your working hours?</button>
                      <button type="button" class="assistant-suggestion" data-question="Do you provide maintenance and support?">Do you provide maintenance and support?</button>
                  </div>
          </div>

    <form class="assistant-input-row" id="assistantForm">
      <label for="assistantInput" class="sr-only">Type your question</label>
      <input type="text" id="assistantInput" class="assistant-input" placeholder="Type a question…" maxlength="200" autocomplete="off">
      <button type="submit" class="assistant-send" aria-label="Send">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h16M13 5l7 7-7 7"/></svg>
      </button>
    </form>
  </div>
</div>

<style>
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}

  .assistant-widget{position:fixed;z-index:1400;font-family:inherit}
  /* Bottom-right per spec, but offset well clear of the right-edge
     Quick Contact tab (which hugs the very edge) rather than sitting
     flush against it, and low enough to sit under where that tab
     typically runs (its mid-page vertical band) rather than beside it. */
  .assistant-widget--frontend{right:92px;bottom:24px}
  .assistant-widget--admin{right:24px;bottom:24px}

  .assistant-toggle{
    position:relative;width:56px;height:56px;border-radius:50%;border:0;cursor:pointer;
    background:linear-gradient(135deg,var(--violet,#6366F1),var(--violet-dark,#4338CA));
    color:#fff;box-shadow:0 10px 28px rgba(67,56,202,.35);
    display:flex;align-items:center;justify-content:center;
    transition:transform .2s ease,box-shadow .2s ease;padding:0
  }
  .assistant-toggle:hover{transform:translateY(-2px) scale(1.03);box-shadow:0 14px 32px rgba(67,56,202,.42)}
  .assistant-toggle svg{width:32px;height:32px}
  .assistant-toggle-badge{position:absolute;top:2px;right:2px;width:11px;height:11px;border-radius:50%;background:var(--teal,#2DD4BF);border:2px solid #fff}
  .assistant-widget.is-open .assistant-toggle{transform:scale(.94)}

  .assistant-panel{
    position:absolute;bottom:68px;right:0;width:min(360px,calc(100vw - 32px));
    max-height:min(560px,calc(100vh - 140px));
    background:#fff;border-radius:18px;overflow:hidden;
    box-shadow:0 24px 60px rgba(20,20,40,.28);border:1px solid var(--line,#E7E7F3);
    display:flex;flex-direction:column;
    opacity:0;transform:translateY(12px) scale(.98);pointer-events:none;
    transition:opacity .2s ease,transform .2s ease
  }
  .assistant-widget.is-open .assistant-panel{opacity:1;transform:translateY(0) scale(1);pointer-events:auto}

  .assistant-header{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:14px 16px;background:linear-gradient(135deg,var(--violet,#6366F1),var(--violet-dark,#4338CA));color:#fff;flex:0 0 auto}
  .assistant-header-info{display:flex;align-items:center;gap:10px;min-width:0}
  .assistant-avatar{flex:0 0 auto;width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.16);display:flex;align-items:center;justify-content:center}
  .assistant-avatar svg{width:24px;height:24px}
  .assistant-title{font-weight:700;font-size:.92rem;line-height:1.2}
  .assistant-subtitle{font-size:.72rem;opacity:.85;line-height:1.2;margin-top:1px}
  .assistant-header-actions{display:flex;align-items:center;gap:4px;flex:0 0 auto}
  .assistant-minimize,.assistant-close{width:28px;height:28px;border-radius:8px;border:0;background:rgba(255,255,255,.14);color:#fff;font-size:1.05rem;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0}
  .assistant-minimize:hover,.assistant-close:hover{background:rgba(255,255,255,.26)}

  .assistant-body{flex:1 1 auto;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:10px;background:var(--panel,#F7F7FB)}
  .assistant-message{max-width:88%;padding:10px 13px;border-radius:14px;font-size:.86rem;line-height:1.5;word-break:break-word}
  .assistant-message p{margin:0 0 4px}
  .assistant-message p:last-child{margin-bottom:0}
  .assistant-message--bot{align-self:flex-start;background:#fff;border:1px solid var(--line,#E7E7F3);color:var(--ink,#1E2233);border-bottom-left-radius:4px}
  .assistant-message--user{align-self:flex-end;background:var(--violet,#6366F1);color:#fff;border-bottom-right-radius:4px}
  .assistant-message-link{display:inline-flex;align-items:center;gap:4px;margin-top:6px;font-weight:600;font-size:.82rem;color:var(--violet-dark,#4338CA);text-decoration:none}
  .assistant-message-link:hover{text-decoration:underline}
  .assistant-contact-card{margin-top:8px;padding-top:8px;border-top:1px dashed var(--line,#E7E7F3);font-size:.82rem;display:flex;flex-direction:column;gap:3px}
  .assistant-contact-card a{color:var(--violet-dark,#4338CA);text-decoration:none;word-break:break-word}
  .assistant-contact-card a:hover{text-decoration:underline}

  .assistant-suggestions{display:flex;flex-direction:column;gap:8px;margin-top:2px}
  .assistant-suggestion{
    text-align:left;background:#fff;border:1px solid var(--line,#E7E7F3);color:var(--ink,#1E2233);
    border-radius:10px;padding:9px 12px;font-size:.82rem;cursor:pointer;transition:border-color .15s ease,background-color .15s ease
  }
  .assistant-suggestion:hover{border-color:var(--violet,#6366F1);background:var(--violet-soft,#EEF0FF)}

  .assistant-input-row{flex:0 0 auto;display:flex;align-items:center;gap:8px;padding:12px;border-top:1px solid var(--line,#E7E7F3);background:#fff}
  .assistant-input{flex:1 1 auto;min-width:0;border:1px solid var(--line,#E7E7F3);border-radius:10px;padding:10px 12px;font-size:.86rem;font-family:inherit}
  .assistant-input:focus{outline:none;border-color:var(--violet,#6366F1)}
  .assistant-send{flex:0 0 auto;width:38px;height:38px;border-radius:10px;border:0;background:var(--violet,#6366F1);color:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer}
  .assistant-send:hover{background:var(--violet-dark,#4338CA)}
  .assistant-send svg{width:18px;height:18px}

  @media (max-width:600px){
    .assistant-widget--frontend{right:14px;bottom:calc(64px + env(safe-area-inset-bottom, 0px) + 12px)}
    .assistant-widget--admin{right:14px;bottom:14px}
    .assistant-toggle{width:50px;height:50px}
    .assistant-toggle svg{width:28px;height:28px}
    .assistant-panel{position:fixed;left:14px;right:14px;top:auto;width:auto;max-height:min(70vh,500px)}
    .assistant-widget--frontend .assistant-panel{bottom:calc(64px + env(safe-area-inset-bottom, 0px) + 12px)}
    .assistant-widget--admin .assistant-panel{bottom:14px}
  }
</style>

<script>
(function () {
  var askUrl = "https:\/\/elancier.com\/assistant\/ask";
  var csrfToken = document.querySelector('meta[name="csrf-token"]');
  csrfToken = csrfToken ? csrfToken.getAttribute('content') : '';
  var contact = {
    phone: "+91 81446 88721",
    email: "admin@elancier.com",
    whatsappLink: "https:\/\/wa.me\/918144688721?text=Hello%2C%20I%20would%20like%20to%20know%20more.",
    contactUrl: "https:\/\/elancier.com\/contact"  };
  var networkErrorMessage = 'Sorry, something went wrong sending that. Please try again in a moment.';

  var root = document.getElementById('assistantWidget');
  var toggle = document.getElementById('assistantToggle');
  var panel = document.getElementById('assistantPanel');
  var closeBtn = document.getElementById('assistantClose');
  var minimizeBtn = document.getElementById('assistantMinimize');
  var body = document.getElementById('assistantBody');
  var form = document.getElementById('assistantForm');
  var input = document.getElementById('assistantInput');
  var sendBtn = form ? form.querySelector('.assistant-send') : null;
  if (!root || !toggle || !panel || !form || !input) return;

  function open() {
    root.classList.add('is-open');
    panel.hidden = false;
    toggle.setAttribute('aria-expanded', 'true');
    setTimeout(function () { input.focus(); }, 150);
  }
  function close() {
    root.classList.remove('is-open');
    toggle.setAttribute('aria-expanded', 'false');
    setTimeout(function () { if (!root.classList.contains('is-open')) panel.hidden = true; }, 200);
  }
  toggle.addEventListener('click', function () {
    root.classList.contains('is-open') ? close() : open();
  });
  if (closeBtn) closeBtn.addEventListener('click', close);
  if (minimizeBtn) minimizeBtn.addEventListener('click', close);
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && root.classList.contains('is-open')) close();
  });
  document.addEventListener('click', function (e) {
    if (root.classList.contains('is-open') && !root.contains(e.target)) close();
  });

  function scrollToBottom() {
    body.scrollTop = body.scrollHeight;
  }

  // All text content is inserted via textContent (never innerHTML),
  // and link hrefs are assigned as element properties — this can't
  // be used to inject markup, whether the text came from a visitor's
  // typed question or from the server's response text. Multi-line
  // answers (e.g. a list of job openings) render as separate <p>
  // lines rather than raw newlines inside one text node.
  function addMessage(text, sender, linkLabel, linkUrl) {
    var msg = document.createElement('div');
    msg.className = 'assistant-message assistant-message--' + sender;
    (text || '').split('\n').forEach(function (line) {
      var p = document.createElement('p');
      p.textContent = line;
      msg.appendChild(p);
    });
    if (linkLabel && linkUrl) {
      var a = document.createElement('a');
      a.className = 'assistant-message-link';
      a.href = linkUrl;
      a.textContent = linkLabel + ' →';
      msg.appendChild(a);
    }
    body.appendChild(msg);
    scrollToBottom();
    return msg;
  }

  function addContactCard(msg) {
    var card = document.createElement('div');
    card.className = 'assistant-contact-card';

    function addLine(label, value, href) {
      if (!value) return;
      var line = document.createElement('div');
      if (href) {
        var a = document.createElement('a');
        a.href = href;
        if (href.indexOf('http') === 0) a.target = '_blank';
        a.rel = 'noopener';
        a.textContent = value;
        line.appendChild(document.createTextNode(label + ': '));
        line.appendChild(a);
      } else {
        line.textContent = label + ': ' + value;
      }
      card.appendChild(line);
    }

    addLine('Phone', contact.phone, contact.phone ? 'tel:' + contact.phone.replace(/[^\d+]/g, '') : null);
    addLine('Email', contact.email, contact.email ? 'mailto:' + contact.email : null);
    addLine('WhatsApp', contact.whatsappLink ? 'Chat with us' : null, contact.whatsappLink);
    var contactLine = document.createElement('div');
    var contactA = document.createElement('a');
    contactA.href = contact.contactUrl;
    contactA.textContent = 'Visit our Contact Us page →';
    contactLine.appendChild(contactA);
    card.appendChild(contactLine);

    msg.appendChild(card);
    scrollToBottom();
  }

  var busy = false;

  function setBusy(state) {
    busy = state;
    input.disabled = state;
    if (sendBtn) sendBtn.disabled = state;
  }

  // Every question — predefined or typed — goes through the same
  // server request, which validates, rate-limits, moderates, matches
  // against live careers/FAQ data, and logs it before replying. The
  // client only renders whatever comes back.
  function askServer(question) {
    if (busy) return; // guards against duplicate/rapid submissions client-side too
    addMessage(question, 'user');
    setBusy(true);

    fetch(askUrl, {
      method: 'POST',
      credentials: 'same-origin',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'X-Requested-With': 'XMLHttpRequest',
        'X-CSRF-TOKEN': csrfToken
      },
      body: JSON.stringify({ question: question, page_url: window.location.href })
    }).then(function (response) {
      return response.json().catch(function () { return {}; }).then(function (data) {
        return { status: response.status, data: data };
      });
    }).then(function (result) {
      if (result.status >= 200 && result.status < 300 && result.data && result.data.answer) {
        var msg = addMessage(result.data.answer, 'bot', result.data.linkLabel, result.data.linkUrl);
        if (result.data.status !== 'answered') addContactCard(msg);
      } else {
        addMessage(networkErrorMessage, 'bot');
      }
    }).catch(function () {
      addMessage(networkErrorMessage, 'bot');
    }).finally(function () {
      setBusy(false);
    });
  }

  var suggestionsWrap = document.getElementById('assistantSuggestions');
  if (suggestionsWrap) {
    suggestionsWrap.addEventListener('click', function (e) {
      var btn = e.target.closest('.assistant-suggestion');
      if (!btn) return;
      askServer(btn.dataset.question);
    });
  }

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var value = input.value.trim();
    if (!value || busy) return;
    askServer(value);
    input.value = '';
  });
}());
</script>

<button class="to-top" aria-label="Back to top">&uarr;</button>
<script>
window.ELANCIER_ASSET_BASE = "https://elancier.com/assets/frontend";
window.ELANCIER_CONTACT_URL = "https://elancier.com/contact";
window.ELANCIER_SETTINGS = {
  phone: "+91 81446 88721",
  email: "admin@elancier.com",
  whatsappLink: "https:\/\/wa.me\/918144688721?text=Hello%2C%20I%20would%20like%20to%20know%20more."};

// --- Mobile nav / Services mega-menu ---------------------------------
// Self-contained: uses its own "is-open" class throughout (see the
// CSS above), so it works correctly whatever else main.js does with
// this markup — this only adds a mobile presentation layer on top,
// it doesn't disable or depend on anything else.
(function () {
  var MOBILE_BREAKPOINT = 860;
  var toggle = document.getElementById('navToggle') || document.querySelector('.nav-cta .nav-toggle');
  var navLinks = document.getElementById('navLinks');
  var closeBtn = document.getElementById('navLinksClose');
  var backdrop = document.getElementById('navBackdrop');
  var megaItem = document.querySelector('.has-mega');
  var megaTrigger = megaItem ? megaItem.querySelector('a[aria-haspopup]') : null;
  var megaPanel = megaItem ? megaItem.querySelector('.mega') : null;
  if (!toggle || !navLinks) return;
  if (toggle.dataset.navInit === '1') return; // guard against this script somehow running twice
  toggle.dataset.navInit = '1';

  var scrollLockY = 0;

  function isMobile() {
    return window.innerWidth <= MOBILE_BREAKPOINT;
  }

  function setMegaOpen(open) {
    if (!megaItem) return;
    megaItem.classList.toggle('is-open', open);
    if (megaTrigger) megaTrigger.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (megaPanel) {
      if (open) {
        // Measured from the panel's real content height (scrollHeight)
        // rather than a fixed guess, so however many categories/links
        // a service has, the submenu always expands to fit all of
        // them — nothing is ever clipped — and still animates smoothly.
        megaPanel.style.maxHeight = megaPanel.scrollHeight + 'px';
      } else {
        megaPanel.style.maxHeight = '0px';
      }
    }
  }

  // The Services trigger stays a real link on desktop (unchanged
  // click-to-visit-the-page + hover-to-preview behaviour), but on
  // mobile it must only ever expand/collapse its submenu — never
  // navigate. Removing the href outright (rather than only relying
  // on a click handler's preventDefault) also stops mobile-only
  // affordances a plain click handler can't catch, such as a
  // long-press "Open in new tab" / "Copy link" context menu or a
  // screen reader announcing it as a page link. The href is restored
  // the moment the viewport is wide enough to be desktop again.
  function syncMegaTriggerMode() {
    if (!megaTrigger) return;
    if (isMobile()) {
      if (megaTrigger.hasAttribute('href')) {
        megaTrigger.dataset.href = megaTrigger.getAttribute('href');
        megaTrigger.removeAttribute('href');
      }
      megaTrigger.setAttribute('role', 'button');
      megaTrigger.setAttribute('tabindex', '0');
    } else if (megaTrigger.dataset.href) {
      megaTrigger.setAttribute('href', megaTrigger.dataset.href);
      megaTrigger.removeAttribute('role');
      megaTrigger.removeAttribute('tabindex');
    }
  }

  function focusableItems() {
    return Array.prototype.slice.call(
      navLinks.querySelectorAll('a[href], button:not([disabled]), [role="button"]')
    ).filter(function (el) { return el.offsetParent !== null; });
  }

  function trapFocus(e) {
    if (e.key !== 'Tab') return;
    var items = focusableItems();
    if (!items.length) return;
    var first = items[0];
    var last = items[items.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  }

  function setNavOpen(open) {
    navLinks.classList.toggle('is-open', open);
    navLinks.setAttribute('aria-hidden', open ? 'false' : 'true');
    if (backdrop) backdrop.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');

    if (open) {
      scrollLockY = window.scrollY || window.pageYOffset || 0;
      document.body.style.top = '-' + scrollLockY + 'px';
      document.body.classList.add('mobile-nav-open');
      document.addEventListener('keydown', trapFocus);
      var items = focusableItems();
      if (items.length) items[0].focus();
    } else {
      setMegaOpen(false);
      document.body.classList.remove('mobile-nav-open');
      document.body.style.top = '';
      window.scrollTo(0, scrollLockY);
      document.removeEventListener('keydown', trapFocus);
      toggle.focus();
    }
  }

  toggle.addEventListener('click', function (e) {
    e.preventDefault();
    setNavOpen(!navLinks.classList.contains('is-open'));
  });

  if (closeBtn) {
    closeBtn.addEventListener('click', function () { setNavOpen(false); });
  }

  if (backdrop) {
    backdrop.addEventListener('click', function () { setNavOpen(false); });
  }

  if (megaTrigger) {
    megaTrigger.addEventListener('click', function (e) {
      if (!isMobile()) return; // desktop keeps its existing hover/click behaviour untouched
      e.preventDefault();
      setMegaOpen(!megaItem.classList.contains('is-open'));
    });
    // With the href removed on mobile the trigger is a role="button"
    // element, so it needs its own Enter/Space handling to stay
    // keyboard-operable the same way a native button would be.
    megaTrigger.addEventListener('keydown', function (e) {
      if (!isMobile()) return;
      if (e.key === 'Enter' || e.key === ' ' || e.key === 'Spacebar') {
        e.preventDefault();
        setMegaOpen(!megaItem.classList.contains('is-open'));
      }
    });
  }

  syncMegaTriggerMode();
  // Landing directly on a service page (e.g. /web-development): the
  // Services link already renders with the "active" class server-side
  // (see header.blade.php) — on mobile, also pre-expand its submenu
  // so the relevant category is visible without an extra tap.
  if (isMobile() && megaTrigger && megaTrigger.classList.contains('active')) {
    setMegaOpen(true);
  }

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && navLinks.classList.contains('is-open')) setNavOpen(false);
  });

  window.addEventListener('resize', function () {
    if (!isMobile() && navLinks.classList.contains('is-open')) setNavOpen(false);
    syncMegaTriggerMode();
    if (megaPanel && megaItem.classList.contains('is-open')) {
      megaPanel.style.maxHeight = megaPanel.scrollHeight + 'px';
    }
  });

  // Close the mobile menu after tapping any real navigation link
  // inside it (but not the Services disclosure trigger itself).
  navLinks.addEventListener('click', function (e) {
    var link = e.target.closest('a');
    if (link && link !== megaTrigger) setNavOpen(false);
  });

  // Back/forward navigation can restore the page from the browser's
  // bfcache with whatever DOM/inline-style state it had right before
  // navigating away — if the drawer was open, that includes the
  // scroll-lock styles. Force everything back to closed/unlocked
  // whenever the page is shown this way.
  window.addEventListener('pageshow', function (e) {
    if (e.persisted) {
      document.body.classList.remove('mobile-nav-open');
      document.body.style.top = '';
      navLinks.classList.remove('is-open');
      if (backdrop) backdrop.classList.remove('is-open');
      setMegaOpen(false);
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open menu');
    }
  });
}());

// --- Toast notifications --------------------------------------------
// Small reusable helper so every AJAX form on the site (contact,
// quick contact, career application) shows the same success/error
// notification, auto-dismissed after a few seconds.
window.ElancierToast = (function () {
  var container = document.getElementById('toast-container');
  function show(message, type, duration) {
    if (!container || !message) return;
    type = type === 'error' ? 'error' : 'success';
    duration = duration || 5000;
    var toast = document.createElement('div');
    toast.className = 'toast toast-' + type;
    toast.setAttribute('role', type === 'error' ? 'alert' : 'status');
    var icon = document.createElement('span');
    icon.className = 'toast-icon';
    icon.setAttribute('aria-hidden', 'true');
    icon.textContent = type === 'error' ? '!' : '\u2713';
    var body = document.createElement('span');
    body.className = 'toast-body';
    body.textContent = message;
    var close = document.createElement('button');
    close.type = 'button';
    close.className = 'toast-close';
    close.setAttribute('aria-label', 'Dismiss notification');
    close.innerHTML = '&times;';
    toast.appendChild(icon);
    toast.appendChild(body);
    toast.appendChild(close);
    container.appendChild(toast);
    requestAnimationFrame(function () { toast.classList.add('is-visible'); });
    var dismissed = false;
    var timer = setTimeout(dismiss, duration);
    function dismiss() {
      if (dismissed) return;
      dismissed = true;
      clearTimeout(timer);
      toast.classList.remove('is-visible');
      setTimeout(function () { if (toast.parentNode) toast.parentNode.removeChild(toast); }, 300);
    }
    close.addEventListener('click', dismiss);
  }
  return { show: show };
}());

// --- AJAX form submission (contact / quick contact / career apply) --
// One shared handler: saves the form via fetch, shows a toast, resets
// the form with no navigation/flicker, blocks duplicate submits while
// a request is in flight, and — on a 422 — fills in field errors
// without touching (or clearing) what the visitor already typed.
window.ElancierAjaxForms = (function () {
  function clearErrors(form) {
    form.querySelectorAll('[data-error-for]').forEach(function (el) { el.textContent = ''; });
    form.querySelectorAll('.field-invalid').forEach(function (el) { el.classList.remove('field-invalid'); });
  }
  function showErrors(form, errors) {
    Object.keys(errors || {}).forEach(function (field) {
      var message = Array.isArray(errors[field]) ? errors[field][0] : errors[field];
      var input = form.querySelector('[name="' + field + '"]');
      var errorEl = form.querySelector('[data-error-for="' + field + '"]');
      if (input && input.closest('.field')) input.closest('.field').classList.add('field-invalid');
      if (errorEl) errorEl.textContent = message;
    });
  }
  function submit(form) {
    if (form.dataset.submitting === '1') return;
    form.dataset.submitting = '1';
    clearErrors(form);
    var submitBtn = form.querySelector('button[type="submit"]');
    var originalLabel = submitBtn ? submitBtn.innerHTML : '';
    var busyLabel = (submitBtn && submitBtn.dataset.busyLabel) || 'Sending...';
    if (submitBtn) { submitBtn.disabled = true; submitBtn.innerHTML = busyLabel; }

    fetch(form.getAttribute('action'), {
      method: 'POST',
      body: new FormData(form),
      credentials: 'same-origin',
      headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
    }).then(function (response) {
      return response.json().catch(function () { return {}; }).then(function (data) {
        return { status: response.status, data: data };
      });
    }).then(function (result) {
      if (result.status >= 200 && result.status < 300) {
        window.ElancierToast.show(result.data.message || 'Thanks — your submission has been received.', 'success');
        form.reset();
        clearErrors(form);
        form.dispatchEvent(new CustomEvent('elancier:ajax-success', { detail: result.data }));
      } else if (result.status === 422 && result.data && result.data.errors) {
        showErrors(form, result.data.errors);
        window.ElancierToast.show(result.data.message || 'Please check the highlighted fields and try again.', 'error');
      } else {
        window.ElancierToast.show('Something went wrong. Please try again.', 'error');
      }
    }).catch(function () {
      window.ElancierToast.show('Network error — please check your connection and try again.', 'error');
    }).finally(function () {
      form.dataset.submitting = '0';
      if (submitBtn) { submitBtn.disabled = false; submitBtn.innerHTML = originalLabel; }
    });
  }
  return { submit: submit };
}());

(function () {
  // Delegated at the document level (capture phase) so this covers
  // every contact-family form on every page — the main Contact form
  // and the Quick Contact widget alike — the moment either is
  // submitted, without needing to know where in the DOM it lives.
  // Running in the capture phase and stopping propagation means it
  // takes over before any other submit handler (e.g. one that shows
  // the old in-panel success message) can run.
  //
  // Matched by URL *path* rather than exact string equality: a form's
  // `action` property is always the fully-resolved absolute URL,
  // which previously had to match window.ELANCIER_CONTACT_URL
  // character-for-character — silently failing to recognise a
  // contact-family form (leaving its old built-in success behaviour
  // to run untouched) if the scheme/host differed for any reason
  // (e.g. APP_URL not exactly matching the live domain) or a
  // trailing slash was present. Comparing just the path avoids all
  // of that.
  function normalizedPath(url) {
    try {
      return new URL(url, window.location.href).pathname.replace(/\/+$/, '');
    } catch (e) {
      return null;
    }
  }
  var contactPath = normalizedPath(window.ELANCIER_CONTACT_URL);

  document.addEventListener('submit', function (e) {
    var form = e.target;
    if (!(form instanceof HTMLFormElement)) return;
    var isAjaxForm = form.hasAttribute('data-ajax-form')
      || (contactPath !== null && normalizedPath(form.action) === contactPath);
    if (!isAjaxForm) return;
    e.preventDefault();
    e.stopImmediatePropagation();
    window.ElancierAjaxForms.submit(form);
  }, true);
}());
</script>
<script src="https://elancier.com/public/assets/frontend/js/main.js"></script>
</body>
</html>
