<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://elancier.com/public/assets/frontend/css/style.css">
<style>
  
  /* Toast notifications for AJAX form submissions (contact, quick
     contact, career application). Uses the same design tokens
     (--violet/--coral/--teal/--ink/--line) as the rest of the site,
     with hard-coded fallbacks in case a token isn't defined. */
  .toast-container{position:fixed;top:20px;right:20px;left:auto;z-index:9999;display:flex;flex-direction:column;gap:10px;width:min(360px,calc(100vw - 32px));pointer-events:none}
  .toast{pointer-events:auto;display:flex;align-items:flex-start;gap:10px;padding:14px 16px;border-radius:12px;background:#fff;box-shadow:0 12px 30px rgba(30,34,51,.16);border:1px solid var(--line,#E7E7F3);font-family:inherit;font-size:.92rem;line-height:1.45;color:var(--ink,#1E2233);opacity:0;transform:translateY(-10px);transition:opacity .25s ease,transform .25s ease}
  .toast.is-visible{opacity:1;transform:translateY(0)}
  .toast-icon{flex:0 0 auto;width:22px;height:22px;margin-top:1px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.72rem;font-weight:700;color:#fff}
  .toast-success .toast-icon{background:var(--violet,#6366F1)}
  .toast-error .toast-icon{background:var(--coral,#FB7185)}
  .toast-body{flex:1 1 auto;min-width:0;word-break:break-word}
  .toast-close{flex:0 0 auto;background:none;border:0;padding:0;margin-left:2px;color:var(--ink-faint,#767C94);cursor:pointer;font-size:1.05rem;line-height:1}
  .toast-close:hover{color:var(--ink,#1E2233)}
  .field.field-invalid input,.field.field-invalid textarea,.field.field-invalid select{border-color:var(--coral,#FB7185) !important}
  @media (max-width:600px){.toast-container{left:16px;right:16px;top:14px;width:auto}}

  /* ===== Mobile optimization ===================================
     Scoped, additive rules only — nothing here removes or overrides
     the site's own desktop/tablet styling above the breakpoints
     used. Two parts:
     1) Safe global guards that can only help, never regress an
        already-working layout (no horizontal scroll, images that
        can't overflow their container, comfortable tap targets, no
        iOS auto-zoom on form focus).
     2) A full, self-contained fix for the header's mobile nav /
        Services mega-menu — the concretely broken behaviour shown in
        testing: on a narrow viewport the desktop 3-column mega panel
        renders at full desktop width and overlaps the page content
        beneath it instead of collapsing into a proper mobile menu.
        This owns its own "is-open" state end-to-end (see the script
        below), so it works correctly regardless of whatever else the
        site's main.js does with this markup — nothing here disables
        or fights it, only adds a mobile-safe presentation layer. */
  html,body{overflow-x:hidden;max-width:100%}
  img,svg,video{max-width:100%;height:auto}
  .nav-backdrop{display:none}
  .nav-drawer-topbar{display:none}
  .nav-drawer-footer{display:none}
  /* Icons/arrows added to each mobile-drawer menu row stay hidden on
     desktop and tablet — the desktop nav keeps its plain text pills,
     unchanged. Only .nav-item-label (the existing link text) shows. */
  .nav-item-icon,.nav-item-arrow,.nav-item-chevron{display:none}

  /* Full-width layout: the site's .container was capped at a
     narrow max-width, leaving large fixed empty gutters on wide
     screens (see reference screenshots). Widened here — once, for
     every page, since they all share this layout — with responsive
     clamp() padding so content still never touches the viewport
     edge, and without removing the cap entirely (which would make
     text lines/cards unnaturally wide on very large screens). */
  .container{max-width:1600px !important;padding-left:clamp(20px,4vw,64px) !important;padding-right:clamp(20px,4vw,64px) !important}

  /* Premium pill-shaped header: sized to its own content
     (width:fit-content) rather than stretched to a fixed max-width —
     stretching it left a large empty gap after the nav links/toggle
     (see reference screenshots), since a flex row using
     justify-content:space-between only spreads elements apart when
     there's leftover width to distribute. Explicit gaps below make
     spacing consistent and deliberate regardless of container width.
     Corners stay a full pill (border-radius:999px) at any height,
     floated off the very top/sides with a soft shadow.
     left:0 + right:0 + margin:auto is what actually centres it: for
     a position:fixed/sticky/absolute element, margin:auto only
     distributes evenly when BOTH edges are pinned — if the header's
     real CSS sets only left:0 (no matching right:0), auto-margin has
     nothing to distribute on the right, which left it hugging the
     left edge with the gap bunched up on the right (see reference
     screenshot). Explicitly pinning both sides fixes that regardless
     of whether the header turns out to be fixed, sticky, or static
     (harmless no-op in the static case, where margin:auto alone
     already centres a block-level fit-content box). */
  .site-header{
    display:block;left:0 !important;right:0 !important;
    width:fit-content !important;max-width:calc(100% - 32px) !important;
    margin:0px auto 0 !important;border-radius:999px !important;
    box-shadow:0 14px 34px rgba(20,20,40,.12) !important;
    z-index:1480 !important;
  }
  .site-header .nav-row{
    display:flex !important;align-items:center !important;
    gap:clamp(16px,3vw,48px) !important;
    padding:14px 30px !important;white-space:nowrap;
  }
  .site-header .nav-links{display:flex !important;align-items:center !important;gap:22px !important;margin:0;padding:0;list-style:none}
  @media (max-width:640px){
    .site-header{max-width:calc(100% - 20px) !important;}
    .site-header .nav-row{padding:10px 16px !important;gap:14px !important}
  }

  /* Stat suffix (e.g. "+" / "k"): rendered as a sibling of the
     animated counter <b>, never inside it — the counter script's
     per-frame textContent writes to <b> can never touch or wipe out
     a sibling element, only a child, which is exactly why it isn't
     nested inside <b>. Both are wrapped together in .stat-value-wrap
     so they're centred as one unit inside the ring; any pre-existing
     rule that centres <b> directly via absolute positioning is
     explicitly neutralised here so it can't fight with the
     wrapper's own centring.
     .stat-value-wrap--long (added server-side when the combined
     value+suffix is 4+ characters, e.g. "1450") scales the group
     down slightly so longer values still fit cleanly inside the
     circle without overflowing its border. */
  .stat-ring-wrap{position:relative}
  .stat-ring-wrap .stat-value-wrap{
    position:absolute !important;inset:0 !important;
    display:flex !important;align-items:center !important;justify-content:center !important;
    gap:1px;line-height:1;pointer-events:none;
  }
  .stat-ring-wrap .stat-value-wrap b{
    position:static !important;top:auto !important;left:auto !important;right:auto !important;bottom:auto !important;
    inset:auto !important;transform:none !important;
  }
  .stat-suffix{font-size:.85em;font-weight:inherit;line-height:1;white-space:nowrap}
  .stat-value-wrap--long{transform:scale(.8)}
  @media (max-width:640px){
    .stat-value-wrap--long{transform:scale(.72)}
  }

  /* Compact stats card: the section was an oversized panel with a
     circle stacked above its label and large empty padding — this
     shrinks the panel and lays each circle+label out horizontally
     (side by side, vertically centred, small fixed gap) instead.
     Scoped under .stats-strip so the shared .grid/.grid-3/.grid-4
     utility classes used elsewhere on the page are never touched. */
  .stats-strip{padding:28px 24px !important}
  .stats-strip .grid{
    display:flex !important;flex-wrap:wrap !important;
    justify-content:center !important;align-items:center !important;
    gap:28px 48px !important;
  }
  .stats-strip .stat-item{
    display:flex !important;flex-direction:row !important;align-items:center !important;
    gap:12px !important;flex:0 0 auto !important;
  }
  .stats-strip .stat-ring-wrap{width:68px !important;height:68px !important;flex:0 0 auto}
  .stats-strip .stat-ring-wrap b{font-size:1.1rem !important}
  .stats-strip .stat-suffix{font-size:.75rem !important}
  .stats-strip .stat-label{white-space:nowrap;font-size:.92rem;line-height:1.3}
  @media (max-width:640px){
    .stats-strip{padding:22px 18px !important}
    .stats-strip .grid{gap:16px 26px !important}
    .stats-strip .stat-ring-wrap{width:56px !important;height:56px !important}
    .stats-strip .stat-ring-wrap b{font-size:.95rem !important}
    .stats-strip .stat-label{font-size:.82rem;white-space:normal}
  }

  /* Dynamic grids: mirrors the site's own .grid-3-fit convention for
     the 4-column sections (services / stats / industries) so a grid
     built for a fixed count never reserves an empty trailing column
     when there are fewer real records — it distributes the actual
     items evenly across the available width instead. Purely
     additive: existing .grid-4 usage elsewhere is untouched, this
     only applies where the extra class is added. */
  .grid.grid-4-fit{grid-template-columns:repeat(auto-fit,minmax(200px,1fr))}

  /* Same idea for the header's Services mega-menu: it was fixed to
     4 columns (one per original service), so 3 active services left
     a blank 4th slot. auto-fit redistributes however many .mega-col
     columns actually exist across the panel's width. */
  header.site-header .mega-inner{grid-template-columns:repeat(auto-fit,minmax(180px,1fr)) !important}

  @media (max-width:860px){
    .btn,button,.nav-links a,.pf-filters button{min-height:44px}
    input,select,textarea{font-size:16px}

    /* Locks background scrolling while the drawer is open (position:fixed
       is the robust cross-browser technique — plain overflow:hidden on
       body alone still allows rubber-band scrolling on iOS Safari).
       JS records the scroll offset before locking and restores it on close. */
    body.mobile-nav-open{position:fixed !important;left:0;right:0;width:100%;overflow:hidden !important}

    header.site-header .nav-cta .nav-toggle{
      display:inline-flex !important;align-items:center;justify-content:center;
      width:38px !important;height:38px !important;padding:0 !important;margin:0;border:0;
      background:transparent;background-image:none !important;cursor:pointer;line-height:1;
      color:var(--ink,#1E2233);position:relative;z-index:1440;
      transition:background-color .15s ease,color .15s ease,transform .1s ease
    }
    header.site-header .nav-cta .nav-toggle::before,
    header.site-header .nav-cta .nav-toggle::after{content:none !important;display:none !important}
    header.site-header .nav-cta .nav-toggle:hover{background:var(--violet-soft,#EEF0FF)}
    header.site-header .nav-cta .nav-toggle:active{transform:scale(.92)}
    header.site-header .nav-cta .nav-toggle:focus-visible{outline:2px solid var(--violet,#6366F1);outline-offset:2px}
    body.mobile-nav-open header.site-header .nav-cta .nav-toggle{background:var(--violet-soft,#EEF0FF);color:var(--violet,#6366F1)}
    header.site-header .nav-toggle i{font-size:17px !important;line-height:1 !important}
    /* Defensive: only ever show the exact controls this file owns.
       If anything else injects an extra icon/button into these
       containers, it's hidden rather than left to render alongside
       ours — this is what actually enforces "only one" regardless
       of what else may be touching this markup. */
    header.site-header .nav-row > *:not(.brand):not(#navLinks):not(.nav-cta){display:none !important}
    header.site-header .nav-cta > *:not(#navToggle){display:none !important}

    /* The drawer. Every visual property that could plausibly be
       overridden by an unrelated rule elsewhere (opacity, background,
       visibility) is pinned explicitly here — a translucent or
       misplaced drawer has been the actual observed bug, not just a
       theoretical risk. z-index sits above the floating Assistant/
       Quick Contact/WhatsApp buttons (all ≤1400) so the open drawer
       + backdrop fully cover them rather than a button poking through.
       Rounded left corners + a dedicated logo/close top bar + a footer
       card give it the app-drawer look from the approved reference,
       while every existing menu link, route and the Services
       mega-menu keep the exact markup/logic they already had. */
    header.site-header #navLinks{
      position:fixed !important;top:0 !important;right:0 !important;left:auto !important;bottom:0 !important;
      height:100vh !important;height:100dvh !important;
      width:min(300px,84vw) !important;max-width:84vw !important;
      margin:0 !important;padding:0 !important;
      border-top-left-radius:22px !important;border-bottom-left-radius:22px !important;
      background-color:#fff !important;background-image:none !important;
      opacity:1 !important;visibility:visible !important;
      backdrop-filter:none !important;-webkit-backdrop-filter:none !important;
      display:flex !important;flex-direction:column !important;align-items:stretch !important;
      list-style:none;gap:0 !important;overflow-y:auto;overflow-x:hidden;
      -webkit-overflow-scrolling:touch;scroll-behavior:smooth;
      box-shadow:-16px 0 40px rgba(20,20,40,.18);
      transform:translateX(100%);transition:transform .35s cubic-bezier(.4,0,.2,1);
      z-index:1460
    }
    header.site-header #navLinks::before,
    header.site-header #navLinks::after{content:none !important;display:none !important}
    header.site-header #navLinks > *:not(li){display:none !important}
    header.site-header #navLinks.is-open{transform:translateX(0) !important}
    header.site-header #navLinks > li{width:100%;flex:0 0 auto}

    /* Logo + close top bar: one compact row, equal padding on all
       four sides (safe-area is added on top of — not instead of —
       that base padding, so a notch never shrinks it), both elements
       vertically centred, logo kept at its natural aspect ratio. */
    header.site-header .nav-drawer-topbar{
      display:flex !important;align-items:center;justify-content:space-between;gap:12px;
      padding:calc(16px + env(safe-area-inset-top,0px)) 16px 16px !important;
      border-bottom:1px solid var(--line,#EEE);margin-bottom:4px;flex:0 0 auto;
    }
    header.site-header .nav-drawer-brand{display:flex;align-items:center;pointer-events:none;line-height:0}
    header.site-header .nav-drawer-logo{height:32px;width:auto;max-width:160px;display:block;object-fit:contain}
    header.site-header .nav-links-close{
      width:40px;height:40px;flex:0 0 auto;border-radius:10px;border:1px solid var(--line,#E7E7F3);background:#fff;
      color:var(--ink,#1E2233);cursor:pointer;display:flex;align-items:center;justify-content:center;
      transition:border-color .15s ease,color .15s ease,transform .1s ease
    }
    header.site-header .nav-links-close i{font-size:15px !important;line-height:1 !important}
    header.site-header .nav-links-close:hover{border-color:var(--violet,#6366F1);color:var(--violet,#6366F1)}
    header.site-header .nav-links-close:active{transform:scale(.92)}
    header.site-header .nav-links-close:focus-visible{outline:2px solid var(--violet,#6366F1);outline-offset:2px}
    header.site-header .nav-links-close::before,
    header.site-header .nav-links-close::after{content:none !important}

    /* Menu rows: icon + label + arrow/chevron, never overlapping or
       truncated (label is the only flexible column, icon/indicator
       are fixed-width so long labels simply wrap instead of clipping
       the icon or the arrow). */
    header.site-header #navLinks > li > a{
      display:flex !important;align-items:center;gap:13px;
      padding:12px 18px;font-size:.92rem;font-weight:600;line-height:1.3;
      border-bottom:1px solid var(--line,#EEE);
      position:relative;color:var(--ink,#1E2233);
      transition:background-color .18s ease,color .18s ease
    }
    header.site-header .nav-item-icon{
      flex:0 0 auto;width:34px;height:34px;border-radius:10px;
      display:flex;align-items:center;justify-content:center;font-size:.85rem;
      background:var(--violet-soft,#EEF0FF);color:var(--violet-dark,#4338CA);
      transition:background-color .18s ease,color .18s ease
    }
    header.site-header .nav-item-label{flex:1 1 auto;min-width:0;overflow-wrap:break-word}
    header.site-header .nav-item-arrow,
    header.site-header .nav-item-chevron{
      display:flex !important;align-items:center;justify-content:center;
      flex:0 0 auto;width:16px;text-align:center;font-size:.72rem;color:var(--ink-faint,#767C94);
      transition:transform .3s ease,color .18s ease
    }

    /* Active item: soft pill background on the whole row (icon badge
       included) + short left accent bar — no long underline, no
       extra height (padding/line-height match every other item). */
    header.site-header #navLinks > li > a.active{
      background:var(--violet-soft,#EEF0FF) !important;color:var(--violet-dark,#4338CA) !important;
      font-weight:700;border-bottom-color:transparent !important; margin: 5px 0px;
    }
    header.site-header #navLinks > li > a.active::before{
      content:'';position:absolute;left:6px;top:50%;transform:translateY(-50%);
      width:3px;height:16px;border-radius:2px;background:var(--violet,#6366F1);
    }
    header.site-header #navLinks > li > a.active .nav-item-icon{background:var(--violet,#6366F1);color:#fff}

    /* Services trigger: highlighted the same way while its submenu is
       open, with the chevron rotating to show expanded state. */
    header.site-header .has-mega.is-open > a{
      background:var(--violet-soft,#EEF0FF) !important;color:var(--violet-dark,#4338CA) !important;font-weight:700;
    }
    header.site-header .has-mega.is-open > a .nav-item-icon{background:var(--violet,#6366F1);color:#fff}
    header.site-header .has-mega.is-open > a .nav-item-chevron i{transform:rotate(180deg);color:var(--violet-dark,#4338CA)}

    /* Submenu: collapsed by default (max-height:0, clipped). JS sets
       an exact pixel max-height (measured from the content's real
       scrollHeight) when opening, so it always fits completely —
       no fixed guess that could clip a longer list, and no reliance
       on a CSS unit some mobile browsers interpolate inconsistently.
       Grouped under each service's existing category heading with a
       small bullet marker per feature link — same links/routes as
       always. The category matching the page you're currently on
       (e.g. /web-development) gets a subtle highlight. */
    header.site-header .has-mega .mega{
      position:static !important;width:100% !important;max-width:100% !important;
      box-shadow:none !important;border:0 !important;background:transparent !important;
      padding:0 !important;margin:0 !important;overflow:hidden;
      display:block !important;max-height:0;
      transition:max-height .35s cubic-bezier(.4,0,.2,1);
    }
    header.site-header .mega-inner{
      display:flex !important;flex-direction:column;gap:16px;
      padding:10px 18px 18px 18px !important;background:var(--bg,#F5F4FB);
    }
    header.site-header .mega-col{padding:2px 0}
    header.site-header .mega-col--active{
      margin:0 -10px;padding:8px 10px;border-radius:12px;
      background:#fff;box-shadow:0 4px 14px rgba(30,34,51,.06);border-left:3px solid var(--violet,#6366F1);
    }
    header.site-header .mega-col h6{
      margin:0 0 8px;font-size:.7rem;font-weight:700;letter-spacing:.07em;
      text-transform:uppercase;color:var(--violet-dark,#4338CA);
    }
    header.site-header .mega-col ul{display:flex;flex-direction:column;gap:2px}
    header.site-header .mega-col ul li a{
      display:flex;align-items:center;gap:10px;padding:8px 8px;border-radius:8px;
      font-size:.84rem;color:var(--ink-soft,#565B72);position:relative;
      transition:background-color .15s ease,color .15s ease,padding-left .15s ease
    }
    header.site-header .mega-col ul li a::before{
      content:'';flex:0 0 auto;width:5px;height:5px;border-radius:50%;
      background:var(--violet,#6366F1);
    }
    header.site-header .mega-col ul li a:hover,
    header.site-header .mega-col ul li a:focus-visible,
    header.site-header .mega-col ul li a.active{
      background:var(--violet-soft,#EEF0FF) !important;color:var(--violet-dark,#4338CA) !important;padding-left:11px;
    }

    /* Footer CTA card, pinned to the bottom of the scroll area with
       the site's own gradient — purely decorative, not a menu item.
       Width is set explicitly (not inherited from the generic
       "#navLinks > li{width:100%}" rule) because 100% *plus* this
       card's own left/right margins was pushing it past the sidebar's
       right edge. Bottom safe-area is added on top of the normal
       bottom margin so it never sits under a gesture bar/browser
       toolbar. Height is intentionally not constrained — it grows
       with its content, however many lines the heading wraps to. */
    header.site-header #navLinks > li.nav-drawer-footer{
      width:calc(100% - 28px) !important;
    }
    header.site-header .nav-drawer-footer{
      display:block !important;box-sizing:border-box;
      margin:auto 14px 0;
      margin-bottom:max(16px,calc(16px + env(safe-area-inset-bottom,0px)));
      padding:16px;border-radius:16px;flex:0 0 auto;
      background:var(--grad-hero);color:#fff;
      /* Reset the "white-space: nowrap" this card was silently
         inheriting from the desktop pill header's ".nav-row" rule
         (a proper ancestor of #navLinks in the DOM) — that inherited
         nowrap, combined with an unnecessary overflow:hidden here,
         was forcing the heading onto one unbreakable line and then
         clipping whatever didn't fit. A gradient background already
         clips to border-radius on its own, so overflow:hidden was
         never actually needed for the rounded corners. */
      white-space:normal;
      overflow:visible;
    }
    header.site-header .nav-drawer-footer-title{
      margin:0 0 6px;font-family:"Sora",sans-serif;
      font-size:clamp(.82rem,3.4vw,.92rem);font-weight:700;
      line-height:1.35;color:#fff;text-shadow:0 1px 3px rgba(30,20,60,.18);
      white-space:normal;overflow-wrap:break-word;word-break:break-word;
      max-width:100%;
    }
    header.site-header .nav-drawer-footer-tag{
      margin:0;font-size:clamp(.68rem,2.6vw,.74rem);letter-spacing:.03em;
      color:#fff;opacity:.96;text-shadow:0 1px 3px rgba(30,20,60,.15);
      white-space:normal;overflow-wrap:break-word;max-width:100%;
    }

    .nav-backdrop{
      display:block;position:fixed;inset:0;background:rgba(15,15,32,.46);z-index:1450;
      opacity:0;pointer-events:none;transition:opacity .3s ease
    }
    .nav-backdrop.is-open{opacity:1;pointer-events:auto}
  }

  .bottom-nav{display:none}

  @media (max-width:860px){
    body{padding-bottom:calc(116px + env(safe-area-inset-bottom,0px))}

    .bottom-nav{
      --nav-gap:4px;
      display:block;position:fixed;left:50%;right:auto;bottom:max(18px,calc(env(safe-area-inset-bottom,0px) + 10px));
      width:min(286px,calc(100vw - 38px));z-index:1420;transform:translate(-50%,120%);
      padding:0;pointer-events:none;animation:bottomNavSlideUp .55s cubic-bezier(.2,.8,.2,1) .12s forwards;
    }
    .bottom-nav-inner{
      position:relative;display:grid;grid-template-columns:repeat(5,1fr);gap:var(--nav-gap);
      min-height:50px;padding:7px 8px;border-radius:999px;border:1px solid rgba(30,34,51,.08);
      background:rgba(255,255,255,.96);box-shadow:0 12px 30px rgba(30,34,51,.18);
      backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);pointer-events:auto;overflow:visible;
    }
    .bottom-nav-indicator{display:none}
    .bottom-nav a{
      position:relative;z-index:1;isolation:isolate;display:flex;align-items:center;justify-content:center;min-width:0;
      height:36px;border-radius:999px;color:#252a3b;-webkit-tap-highlight-color:transparent;
      transition:color .24s ease,transform .24s cubic-bezier(.2,.8,.2,1),opacity .24s ease;
    }
    .bottom-nav a svg{position:relative;z-index:2;width:17px;height:17px;transition:transform .3s cubic-bezier(.2,1.35,.25,1),filter .24s ease}
    .bottom-nav a.active{color:#fff;animation:bottomNavPop .42s cubic-bezier(.2,1.35,.25,1) both}
.bottom-nav a.active::before{ 
    content:''; 
    position:absolute; 
    left:50%; 
    top:-11px; 
    z-index:1; 
    width:38px; 
    height:38px; 
    border-radius:50%; 
    transform:translateX(-50%); 

    background:#EE9E04; 

    box-shadow: 
        0 0 0 6px rgba(255,255,255,.9), 
        0 10px 22px rgba(238,158,4,.34), 
        0 3px 8px rgba(238,158,4,.18);

    animation:bottomNavBubble .42s cubic-bezier(.2,1.35,.25,1) both; 
}
    .bottom-nav a.active::after{
      content:'';position:absolute;left:50%;bottom:1px;z-index:1;width:22px;height:3px;border-radius:999px;
      transform:translateX(-50%);background: #257072;opacity:.82;
    }
    .bottom-nav a.active svg{transform:translateY(-11px) scale(.92);filter:drop-shadow(0 4px 7px rgba(30,34,51,.2))}
    .bottom-nav a:active svg{transform:translateY(-8px) scale(.86)}
    .bottom-nav a:focus-visible{outline:2px solid #ff4f93;outline-offset:3px}

    @keyframes bottomNavSlideUp{
      from{opacity:0;transform:translate(-50%,120%) scale(.96)}
      to{opacity:1;transform:translate(-50%,0) scale(1)}
    }
    @keyframes bottomNavPop{
      0%{transform:translateY(0) scale(.9)}
      58%{transform:translateY(-6px) scale(1.06)}
      100%{transform:translateY(0) scale(1)}
    }
    @keyframes bottomNavBubble{
      0%{transform:translateX(-50%) translateY(10px) scale(.76)}
      58%{transform:translateX(-50%) translateY(-3px) scale(1.08)}
      100%{transform:translateX(-50%) translateY(0) scale(1)}
    }
  }

  @media (prefers-reduced-motion:reduce){
    .bottom-nav{animation:none !important;transform:translate(-50%,0)}
    .bottom-nav a{animation:none !important}
    .bottom-nav-indicator,.bottom-nav a,.bottom-nav a svg{transition:none !important}
  }
  .preloader,.page-exit-overlay{display:none !important}
</style>
</head>
