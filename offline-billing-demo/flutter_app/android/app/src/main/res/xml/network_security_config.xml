<?xml version="1.0" encoding="utf-8"?>
<!--
  Release builds allow HTTP only for local development hosts.
  Public API hosts stay HTTPS-only. To test a release build against a
  computer on the same LAN, add that computer's IP as another domain entry.
  Debug and profile manifests permit cleartext so `flutter run` can use a LAN IP.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
